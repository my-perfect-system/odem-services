# Ansible managed — rendered by the odem.services.openvpn role.
# Server address/hostname used in .ovpn client configs (remote directive)
SERVER_ADDRESS={{ openvpn_server_address }}

# CA certificate subject fields (Easy-RSA)
EASYRSA_REQ_COUNTRY="{{ openvpn_easyrsa_req_country }}"
EASYRSA_REQ_PROVINCE="{{ openvpn_easyrsa_req_province }}"
EASYRSA_REQ_CITY="{{ openvpn_easyrsa_req_city }}"
EASYRSA_REQ_ORG="{{ openvpn_easyrsa_req_org }}"
EASYRSA_REQ_EMAIL="{{ openvpn_easyrsa_req_email }}"
EASYRSA_REQ_OU="{{ openvpn_easyrsa_req_ou }}"
EASYRSA_KEY_SIZE={{ openvpn_easyrsa_key_size }}
EASYRSA_ALGO={{ openvpn_easyrsa_algo }}
EASYRSA_CA_EXPIRE={{ openvpn_easyrsa_ca_expire }}
EASYRSA_CERT_EXPIRE={{ openvpn_easyrsa_cert_expire }}
