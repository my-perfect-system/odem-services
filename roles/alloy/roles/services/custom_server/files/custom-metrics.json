[
  {
    "name": "custom_endpoint_uptime_seconds",
    "help": "System uptime in seconds",
    "type": "gauge",
    "command": "cat /proc/uptime | awk '{print $1}'"
  },
  {
    "name": "custom_endpoint_logged_in_users",
    "help": "Number of logged-in users",
    "type": "gauge",
    "command": "who | wc -l"
  },
  {
    "name": "custom_endpoint_reboot_required",
    "help": "Whether a reboot is required (1=yes, 0=no)",
    "type": "gauge",
    "command": "test -f /var/run/reboot-required && echo 1 || echo 0"
  },
  {
    "name": "custom_endpoint_apt_upgrades_available",
    "help": "Number of available apt upgrades",
    "type": "gauge",
    "command": "apt list --upgradable 2>/dev/null | grep -c upgradable || echo 0"
  },
  {
    "name": "custom_endpoint_zombie_processes",
    "help": "Number of zombie processes",
    "type": "gauge",
    "command": "ps aux | awk '{print $8}' | grep -c Z || echo 0"
  },
  {
    "name": "custom_endpoint_disk_read_tps_total",
    "help": "Total disk reads completed per second (across all devices)",
    "type": "counter",
    "command": "awk '{r+=$3} END {print r}' /proc/diskstats"
  },
  {
    "name": "custom_endpoint_alarmtrigger",
    "help": "Test Alarm",
    "type": "counter",
    "command": "echo 0"
  }
]
