# Ansible managed — rendered by the odem.services.monitoring role.

# Network bind configuration
BIND_IP={{ monitoring_bind_ip }}

# Service ports (host-side)
GRAFANA_PORT={{ monitoring_grafana_port }}
PROMETHEUS_PORT={{ monitoring_prometheus_port }}
LOKI_PORT={{ monitoring_loki_port }}

# Grafana admin credentials
GRAFANA_ADMIN_USER={{ monitoring_grafana_admin_user }}
GRAFANA_ADMIN_PASSWORD={{ monitoring_grafana_admin_password }}

# Image versions
PROMETHEUS_VERSION={{ monitoring_prometheus_version }}
LOKI_VERSION={{ monitoring_loki_version }}
GRAFANA_VERSION={{ monitoring_grafana_version }}
